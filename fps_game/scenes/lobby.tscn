[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_lobby")

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.09, 0.1, 0.12, 1)

[node name="Box" type="VBoxContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -250.0
offset_right = 260.0
offset_bottom = 250.0
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Box"]
theme_override_font_sizes/font_size = 40
text = "LAN 1v1"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Box"]
modulate = Color(1, 1, 1, 0.6)
theme_override_font_sizes/font_size = 14
text = "Both players fight with the host's combat settings. First to 3 rounds."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Host" type="Button" parent="Box"]
custom_minimum_size = Vector2(0, 48)
theme_override_font_sizes/font_size = 20
text = "Host Match"

[node name="JoinRow" type="HBoxContainer" parent="Box"]

[node name="Address" type="LineEdit" parent="Box/JoinRow"]
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
placeholder_text = "Host IP, e.g. 192.168.1.20"

[node name="Join" type="Button" parent="Box/JoinRow"]
custom_minimum_size = Vector2(120, 44)
theme_override_font_sizes/font_size = 18
text = "Join"

[node name="HostsLabel" type="Label" parent="Box"]
theme_override_font_sizes/font_size = 14
text = "Games found on your network (double-click to join):"

[node name="Hosts" type="ItemList" parent="Box"]
custom_minimum_size = Vector2(0, 110)
theme_override_font_sizes/font_size = 16

[node name="Status" type="Label" parent="Box"]
theme_override_colors/font_color = Color(0.75, 0.9, 0.75, 1)
theme_override_font_sizes/font_size = 15
horizontal_alignment = 1
autowrap_mode = 3

[node name="Back" type="Button" parent="Box"]
custom_minimum_size = Vector2(0, 44)
